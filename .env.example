# Template for treasury/.env. Copy to treasury/.env and fill in the REPLACE_ME
# values. The real .env file is gitignored.
#
# See ROTATION.md for what needs to change between local-dev and VPS-prod.

# --- RPC pool ---
RPC_HELIUS=https://mainnet.helius-rpc.com/?api-key=REPLACE_ME
RPC_TRITON=
RPC_QUICKNODE=
RPC_PUBLIC=https://api.mainnet-beta.solana.com
RPC_WS_HELIUS=
RPC_WS_PUBLIC=wss://api.mainnet-beta.solana.com

# --- Jito ---
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_TIP_LAMPORTS=10000

# --- Optional Tor SOCKS5 proxy ---
# When set, every HTTP request (RPC, Jupiter, Jito, diag) is tunneled.
#   socks5h://127.0.0.1:9150  - Tor Browser bundle (must be running)
#   socks5h://127.0.0.1:9050  - standalone tor service
# Leave BLANK on VPS unless you have a specific reason; latency hurts fills.
# Confirm with the dashboard's "Check Tor egress IP" button after starting.
TOR_PROXY=

# --- Optional: Tor control port for automatic NEWNYM circuit rotation on 429 ---
# When the RPC layer hits "Too Many Requests" the manager will SIGNAL NEWNYM
# to rotate exit nodes IF these are set. Treasury normally runs on a SEPARATE
# Tor instance (SOCKS 9250 / Control 9251) — point this at THAT instance's
# control port and cookie, not the MM one on 9151.
TOR_CONTROL_HOST=127.0.0.1
TOR_CONTROL_PORT=
TOR_CONTROL_COOKIE=
# Alternative to cookie auth (matches `HashedControlPassword` in torrc):
TOR_CONTROL_PASSWORD=

# --- Treasury vault ---
# TREASURY_* prefixes keep this separate from MM (AMM_VAULT_* in apps/web .env.local).
# For headless/unattended startup set TREASURY_VAULT_PASSPHRASE. Omit TREASURY_VAULT_PATH
# and use treasury.config.json `vault.path` only (recommended: repo .amm-treasury vault file).
#
TREASURY_VAULT_PATH=./.amm-treasury/vault.enc
TREASURY_VAULT_PASSPHRASE=REPLACE_ME_TREASURY_VAULT_PASSPHRASE

# --- Web UI ---
# Optional. When set, gates POST /api/control/* with `x-treasury-token` header.
TREASURY_WEB_TOKEN=

# --- Logging ---
LOG_LEVEL=info
LOG_PRETTY=true
